layout: layouts/base.njk
---

{# Hero #}
<section class="hero">
    <div class="hero-content">
        <p class="hero-whisper reveal">know yourself. understand others.</p>
        <h1 class="reveal reveal-delay-1">
            The <span class="hero-gradient-text">Channel</span>
        </h1>
        <p class="hero-subtitle reveal reveal-delay-2">Know yourself. Understand the people you love.</p>
        <a href="{{ site.appUrl }}" class="journey-button reveal reveal-delay-3">Begin Your Journey</a>
        {# TODO: Re-enable store buttons when apps ship
        <div class="store-buttons reveal reveal-delay-3">
            <a href="{{ site.playStoreUrl }}" class="store-button" target="_blank">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 2.302a1 1 0 0 1 0 1.38l-2.302 2.302L15.5 12l2.198-2.492zM5.864 2.658L16.8 8.99l-2.302 2.302-8.635-8.635z"/></svg>
                <div>
                    <span class="store-label">Get it on</span>
                    <span class="store-name">Google Play</span>
                </div>
            </a>
            <a href="#" class="store-button" target="_blank">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                <div>
                    <span class="store-label">Download on the</span>
                    <span class="store-name">App Store</span>
                </div>
            </a>
        </div>
        #}
    </div>
</section>

{# Meet Julie #}
<section class="julie-section-home" id="julie">
    <div class="container">
        <div class="julie-content">
            <div class="julie-text">
                <p class="storybook-intro reveal">Once upon a time, someone wanted to understand you.</p>
                <h2 class="reveal reveal-delay-1">Meet Julie</h2>
                <p class="reveal reveal-delay-2">Julie is warm, perceptive, and a little bit magical. She pays attention to things most people miss — the patterns in how you love, the way you go quiet when you're hurt, the things you say between the lines.</p>
                <p class="reveal reveal-delay-3">The more you talk to her, the more she sees. And the more she sees, the more she can help — not with generic advice, but with the kind of gentle, specific truth that only comes from someone who really, truly knows you.</p>
            </div>
            <div class="julie-visual reveal">
                <div class="julie-orb"></div>
            </div>
        </div>
    </div>
</section>

{# What Julie Sees — Phone Screenshots #}
<section class="features-section" id="features">
    <div class="container">
        <div class="section-header">
            <h2 class="reveal">A peek inside</h2>
            <p class="reveal reveal-delay-1">Here's what it looks like when someone truly pays attention.</p>
        </div>
        <div class="features-phones">
            <div class="feature-phone-item reveal">
                <div class="phone-container">
                    <div class="phone-frame">
                        <div class="screen">
                            <img src="{{ '/assets/screenshot-chat.jpg' | url }}" alt="Chat with Julie" class="screenshot">
                        </div>
                        <div class="button-right"></div>
                        <div class="buttons-left">
                            <div class="button-left"></div>
                            <div class="button-left"></div>
                        </div>
                    </div>
                </div>
                <div class="feature-phone-label">
                    <h3>You talk. She listens.</h3>
                    <p>Tell her what's on your mind. She won't judge. She won't forget. She'll just... understand.</p>
                </div>
            </div>

            <div class="feature-phone-item reveal reveal-delay-1">
                <div class="phone-container">
                    <div class="phone-frame">
                        <div class="screen">
                            <img src="{{ '/assets/screenshot-insights.jpg' | url }}" alt="Your Insights" class="screenshot">
                        </div>
                        <div class="button-right"></div>
                        <div class="buttons-left">
                            <div class="button-left"></div>
                            <div class="button-left"></div>
                        </div>
                    </div>
                </div>
                <div class="feature-phone-label">
                    <h3>She notices what you miss</h3>
                    <p>Patterns, blind spots, the things you feel but can't quite name. Julie turns them into little cards of clarity.</p>
                </div>
            </div>

            <div class="feature-phone-item reveal reveal-delay-2">
                <div class="phone-container">
                    <div class="phone-frame">
                        <div class="screen">
                            <img src="{{ '/assets/screenshot-home.jpg' | url }}" alt="Home Page" class="screenshot">
                        </div>
                        <div class="button-right"></div>
                        <div class="buttons-left">
                            <div class="button-left"></div>
                            <div class="button-left"></div>
                        </div>
                    </div>
                </div>
                <div class="feature-phone-label">
                    <h3>Your people, understood</h3>
                    <p>A living page for everyone who matters to you. What they need, how you connect, and where things get tangled.</p>
                </div>
            </div>
        </div>
    </div>
</section>

{# CTA #}
